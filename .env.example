# Local: npm ci; npm run build; npm start (set APP_ORIGIN=http://localhost:3000)
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DB_PATH=data/outpost.sqlite
ROUND_SECONDS=40
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
# RainbowKit login. Browser extension wallets work without this.
# Set a WalletConnect Cloud project id before building if you want QR pairing.
VITE_WALLETCONNECT_PROJECT_ID=
# Leave checkout disabled until deployed. Never put private keys in VITE_* variables.
STORE_ADDRESS=
TOKEN_ADDRESS=
STABLE_ADDRESS=
AGENT_ID_ADDRESS=
# Operator-only OWNER_PRIVATE_KEY opens testnet Agent ID mint with an explicit --broadcast.
# Never place owner/deployer keys in the hosted app environment.
TOKEN_DECIMALS=18
STABLE_DECIMALS=6
QUOTE_SIGNER_PRIVATE_KEY=
QUOTE_SIGNER_ADDRESS=
OWNER_ADDRESS=
TREASURY_ADDRESS=
DEPLOYER_PRIVATE_KEY=
# TEST_BUYER_PRIVATE_KEY belongs in the operator shell for a one-off testnet smoke run,
# not the production app environment.
CONFIRMATIONS=3
# Merchant's token quantity per USD of cosmetic price; NOT an oracle price.
# Leave blank to disable RIVAL quotes independently of USDG checkout.
TOKEN_UNITS_PER_DOLLAR=
# scenario (default) or robinhood. Failed live feed becomes neutral.
MARKET_MODE=scenario
MARKET_SYMBOL=NVDA
# o1 unsigned launch preparation; never available in browser.
O1_API_KEY=
LAUNCH_CREATOR=
PUBLIC_WEBSITE=
TOKEN_IMAGE=public/hood-rivals-logo.png

# Exact trusted reverse-proxy hop count (0 = direct). Never guess on public hosts.
TRUST_PROXY_HOPS=0
# Source release identifier displayed in bootstrap metadata.
BUILD_SHA=
